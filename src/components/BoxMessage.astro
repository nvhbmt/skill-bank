---
interface Props {
    unreadCount?: number;
}

const { unreadCount = 2 } = Astro.props;
import '@/assets/css/footer.css';
import { getStaticPaths, useTranslate } from '@/i18n';
export { getStaticPaths };

const { lang, t, l } = useTranslate(Astro);
---

<style>
    :root {
        --msg-bg: #1a1a2e; /* Nền ko đen hẳn cho box mess*/
        --msg-border: rgba(255, 255, 255, 0.1);
    }

    .message-dropdown {
        position: relative;
    }

    .header-message {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.8rem;
        height: 2.8rem;
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        color: var(--color-text-invert);
        position: relative;
    }

    .header-message:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }

    .header-message ion-icon {
        font-size: 1.8rem;
    }

    .message-badge {
        position: absolute;
        top: -0.2rem;
        right: -0.2rem;
        background: #ef4444;
        color: white;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.2rem 0.4rem;
        border-radius: 10px;
        min-width: 1.2rem;
        text-align: center;
        line-height: 1;
    }

    .message-box {
        position: absolute;
        top: calc(100% + 1.2rem);
        right: 0;
        width: 360px;
        max-height: 500px;
        background: rgba(45, 45, 50, 0.98);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-8px);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10000;
    }

    .message-box.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    .mb-header {
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .mb-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-text-invert);
    }

    .btn-close {
        background: transparent;
        border: none;
        color: var(--color-surface);
        font-size: 20px;
        cursor: pointer;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: background 0.2s;
    }
    .btn-close:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .mb-search {
        padding: 12px 16px;
    }
    .mb-search-input-container {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .search-icon {
        color: var(--color-bg-soft);
        font-size: 14px;
    }

    .mb-search-input {
        background: transparent;
        border: none;
        color: var(--color-bg-light);
        font-size: 14px;
        width: 100%;
        outline: none;
    }
    .mb-search-input::placeholder {
        color: var(--color-bg-soft);
        opacity: 0.7;
    }

    .mb-list {
        display: flex;
        flex-direction: column;
        max-height: 400px;
        overflow-y: auto;
        padding: 8px 0;
    }

    /* Scroll */
    .mb-list::-webkit-scrollbar {
        width: 6px;
    }
    .mb-list::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
    }
    .mb-list::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }
    .mb-list::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    .mb-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        text-decoration: none;
        transition: background 0.2s;
        cursor: pointer;
    }

    .mb-item:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Avatar */
    .mb-avatar-wrapper {
        position: relative;
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        overflow: hidden;
        border-radius: 50%;
    }
    .mb-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        background-color: #333;
        display: block;
    }

    .mb-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .mb-row-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }

    .mb-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--color-text-invert);
    }

    .mb-time {
        font-size: 11px;
        color: var(--color-bg-soft);
    }

    .mb-text {
        font-size: 13px;
        color: var(--color-bg-soft);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mb-item.unread .mb-text {
        color: var(--color-primary-light);
        font-weight: 600;
    }
    .mb-item.unread .mb-name {
        color: white;
    }
    /*Chấm tím */
    .mb-item.unread .mb-unread-dot {
        width: 10px;
        height: 10px;
        background-color: var(--color-purple-button);
        border-radius: 50%;
        flex-shrink: 0;
        margin-left: 8px;
        box-shadow: 0 0 5px var(--color-purple-button);
    }
</style>

<div class="message-dropdown">
    <button class="header-message" id="message-button" aria-label="Messages">
        <ion-icon name="chatbubble-outline"></ion-icon>
        {unreadCount > 0 && <span class="message-badge">{unreadCount}</span>}
    </button>

    <!-- Message Dropdown Menu -->
    <div class="message-box" id="message-dropdown-menu">
        <div class="mb-header">
            <div class="mb-title">
                {t('box-message.message')} ({unreadCount})
            </div>
        </div>

        <div class="mb-search">
            <div class="mb-search-input-container">
                <i class="fa-solid fa-magnifying-glass search-icon"></i>
                <input
                    type="text"
                    class="mb-search-input"
                    placeholder={t('box-message.search')}
                />
            </div>
        </div>

        <div class="mb-list">
            <a
                class="mb-item unread"
                data-chat-id="user-1"
                data-user-name="Bùi Thái Vy"
                data-user-avatar="/assets/images/avatar-default-icon.png"
            >
                <div class="mb-avatar-wrapper">
                    <img
                        src="/assets/images/avatar-default-icon.png"
                        alt="Avatar"
                        class="mb-avatar"
                    />
                </div>
                <div class="mb-content">
                    <div class="mb-row-top">
                        <span class="mb-name">Bùi Thái Vy</span>
                        <span class="mb-time">2p</span>
                    </div>
                    <div
                        style="
                display: flex;
                justify-content: space-between;
                align-items: center;
              "
                    >
                        <p class="mb-text">Mình muốn hỏi thêm về dự án...</p>
                        <span class="mb-unread-dot"></span>
                    </div>
                </div>
            </a>

            <a
                class="mb-item unread"
                data-chat-id="user-2"
                data-user-name="Nguyễn Việt Hoàng"
                data-user-avatar="/assets/images/avatar-default-icon.png"
            >
                <div class="mb-avatar-wrapper">
                    <img
                        src="/assets/images/avatar-default-icon.png"
                        alt="Avatar"
                        class="mb-avatar"
                    />
                </div>
                <div class="mb-content">
                    <div class="mb-row-top">
                        <span class="mb-name">Nguyễn Việt Hoàng</span>
                        <span class="mb-time">1h</span>
                    </div>
                    <div
                        style="
                display: flex;
                justify-content: space-between;
                align-items: center;
              "
                    >
                        <p class="mb-text">
                            Đã gửi file thiết kế, bạn check nhé.
                        </p>
                        <span class="mb-unread-dot"></span>
                    </div>
                </div>
            </a>

            <a
                class="mb-item"
                data-chat-id="user-3"
                data-user-name="Lý Anh Huy"
                data-user-avatar="/assets/images/avatar-default-icon.png"
            >
                <div class="mb-avatar-wrapper">
                    <img
                        src="/assets/images/avatar-default-icon.png"
                        alt="Avatar"
                        class="mb-avatar"
                    />
                </div>
                <div class="mb-content">
                    <div class="mb-row-top">
                        <span class="mb-name">Lý Anh Huy</span>
                        <span class="mb-time">Hôm qua</span>
                    </div>
                    <p class="mb-text">Bạn: Ok chốt lịch họp nhé.</p>
                </div>
            </a>

            <a
                class="mb-item"
                data-chat-id="user-4"
                data-user-name="Quỳnh Chi"
                data-user-avatar="/assets/images/avatar-default-icon.png"
            >
                <div class="mb-avatar-wrapper">
                    <img
                        src="/assets/images/avatar-default-icon.png"
                        alt="Avatar"
                        class="mb-avatar"
                    />
                </div>
                <div class="mb-content">
                    <div class="mb-row-top">
                        <span class="mb-name">Quỳnh Chi</span>
                        <span class="mb-time">T2</span>
                    </div>
                    <p class="mb-text">API login đang bị lỗi CORS.</p>
                </div>
            </a>

            <a
                class="mb-item"
                data-chat-id="user-5"
                data-user-name="Trọng Nhân"
                data-user-avatar="/assets/images/avatar-default-icon.png"
            >
                <div class="mb-avatar-wrapper">
                    <img
                        src="/assets/images/avatar-default-icon.png"
                        alt="Avatar"
                        class="mb-avatar"
                    />
                </div>
                <div class="mb-content">
                    <div class="mb-row-top">
                        <span class="mb-name">Trọng Nhân</span>
                        <span class="mb-time">T2</span>
                    </div>
                    <p class="mb-text">Dự án này còn tuyển không bạn?</p>
                </div>
            </a>
        </div>
    </div>
</div>

<script>
    (function () {
        // Prevent multiple initializations
        if ((window as any).messageDropdownInitialized) {
            return;
        }
        (window as any).messageDropdownInitialized = true;

        function initMessageDropdown() {
            const messageButton = document.getElementById('message-button');
            const dropdownMenu = document.getElementById(
                'message-dropdown-menu'
            );
            const closeButton = document.getElementById('message-close-button');

            // Toggle dropdown menu
            if (messageButton && dropdownMenu) {
                // Remove existing listeners to prevent duplicates
                const newMessageButton = messageButton.cloneNode(true);
                messageButton.parentNode?.replaceChild(
                    newMessageButton,
                    messageButton
                );
                const newButton = document.getElementById('message-button');

                if (newButton) {
                    newButton.addEventListener('click', function (e: Event) {
                        e.stopPropagation();
                        dropdownMenu.classList.toggle('active');
                    });
                }

                // Close button
                if (closeButton) {
                    closeButton.addEventListener('click', function (e: Event) {
                        e.stopPropagation();
                        dropdownMenu.classList.remove('active');
                    });
                }

                // Close dropdown when clicking outside
                const clickOutsideHandler = function (e: Event) {
                    const target = e.target as HTMLElement;
                    if (!target) return;
                    const button = document.getElementById('message-button');
                    const menu = document.getElementById(
                        'message-dropdown-menu'
                    );
                    if (button && menu) {
                        const isClickInside =
                            button.contains(target) || menu.contains(target);

                        if (
                            !isClickInside &&
                            menu.classList.contains('active')
                        ) {
                            menu.classList.remove('active');
                        }
                    }
                };

                // Remove old listener if exists
                document.removeEventListener('click', clickOutsideHandler);
                document.addEventListener('click', clickOutsideHandler);

                // Open chat window when clicking on message items
                const messageItems = dropdownMenu.querySelectorAll('.mb-item');
                messageItems.forEach(function (item) {
                    item.addEventListener('click', function (e) {
                        e.preventDefault();
                        e.stopPropagation();

                        const chatId = item.getAttribute('data-chat-id');
                        const userName = item.getAttribute('data-user-name');
                        const userAvatar =
                            item.getAttribute('data-user-avatar');

                        console.log('Message item clicked:', {
                            chatId,
                            userName,
                            userAvatar,
                        });

                        if (chatId && userName && userAvatar) {
                            // Check if chat window already exists
                            const existingChat = document.getElementById(
                                `chat-window-${chatId}`
                            );
                            if (existingChat) {
                                // Bring to front
                                existingChat.style.zIndex = String(
                                    9999 + (Date.now() % 1000)
                                );
                                existingChat.classList.remove('minimized');
                                existingChat.classList.add('active');
                            } else {
                                // Open new chat window
                                const openChatFn = (window as any)
                                    .openChatWindow;
                                if (
                                    openChatFn &&
                                    typeof openChatFn === 'function'
                                ) {
                                    console.log('Calling openChatWindow');
                                    openChatFn(chatId, userName, userAvatar);
                                } else {
                                    console.error(
                                        'openChatWindow function not found. Retrying...'
                                    );
                                    // Retry after a short delay
                                    setTimeout(() => {
                                        const retryFn = (window as any)
                                            .openChatWindow;
                                        if (
                                            retryFn &&
                                            typeof retryFn === 'function'
                                        ) {
                                            retryFn(
                                                chatId,
                                                userName,
                                                userAvatar
                                            );
                                        } else {
                                            console.error(
                                                'Failed to open chat window: function not available'
                                            );
                                        }
                                    }, 200);
                                }
                            }
                        }

                        // Close dropdown
                        setTimeout(() => {
                            dropdownMenu.classList.remove('active');
                        }, 100);
                    });
                });
            }
        }

        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMessageDropdown);
        } else {
            initMessageDropdown();
        }
    })();
</script>
