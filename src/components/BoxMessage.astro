---
import { useTranslate } from '@/i18n';
import { getConversations, getUnreadCount } from '@/services/messages';

const { t, l } = useTranslate(Astro);
const session = Astro.locals.session;
const userId = session?.user?.id ?? null;

// Trước đây component này render danh sách hội thoại hardcode ("Bùi Thái Vy",
// "Mình muốn hỏi thêm về dự án...") và Header cũng không hiển thị nó.
const conversations = userId
    ? (await getConversations(userId)).slice(0, 6)
    : [];
const unreadCount = userId ? await getUnreadCount(userId) : 0;

function formatTime(value: string | null): string {
    if (!value) return '';
    try {
        const diffMs = Date.now() - new Date(value).getTime();
        const mins = Math.floor(diffMs / 60000);
        if (mins < 60) return `${Math.max(mins, 1)}p`;
        const hours = Math.floor(diffMs / 3600000);
        if (hours < 24) return `${hours}h`;
        return `${Math.floor(diffMs / 86400000)}n`;
    } catch {
        return '';
    }
}
---

<style>
    :root {
        --msg-bg: #1a1a2e; /* Nền ko đen hẳn cho box mess*/
        --msg-border: rgba(255, 255, 255, 0.1);
    }

    .message-dropdown {
        position: relative;
    }

    .header-message {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.8rem;
        height: 2.8rem;
        background: transparent;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s ease;
        color: var(--color-text-invert);
        position: relative;
    }

    .header-message:hover {
        background: rgba(255, 255, 255, 0.1);
        transform: translateY(-2px);
    }

    .header-message ion-icon {
        font-size: 1.8rem;
    }

    .message-badge {
        position: absolute;
        top: -0.2rem;
        right: -0.2rem;
        background: #ef4444;
        color: white;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 0.2rem 0.4rem;
        border-radius: 10px;
        min-width: 1.2rem;
        text-align: center;
        line-height: 1;
    }

    .message-box {
        position: absolute;
        top: calc(100% + 1.2rem);
        right: 0;
        width: 360px;
        max-height: 500px;
        background: rgba(45, 45, 50, 0.98);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 16px;
        padding: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-8px);
        transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 10000;
    }

    .message-box.active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(0);
    }

    .mb-header {
        padding: 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
    }

    .mb-title {
        font-size: 20px;
        font-weight: 700;
        color: var(--color-text-invert);
    }

    .btn-close {
        background: transparent;
        border: none;
        color: var(--color-surface);
        font-size: 20px;
        cursor: pointer;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        transition: background 0.2s;
    }
    .btn-close:hover {
        background-color: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .mb-search {
        padding: 12px 16px;
    }
    .mb-search-input-container {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        padding: 8px 12px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .search-icon {
        color: var(--color-bg-soft);
        font-size: 14px;
    }

    .mb-search-input {
        background: transparent;
        border: none;
        color: var(--color-bg-light);
        font-size: 14px;
        width: 100%;
        outline: none;
    }
    .mb-search-input::placeholder {
        color: var(--color-bg-soft);
        opacity: 0.7;
    }

    .mb-list {
        display: flex;
        flex-direction: column;
        max-height: 400px;
        overflow-y: auto;
        padding: 8px 0;
    }

    /* Scroll */
    .mb-list::-webkit-scrollbar {
        width: 6px;
    }
    .mb-list::-webkit-scrollbar-track {
        background: rgba(255, 255, 255, 0.05);
    }
    .mb-list::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.2);
        border-radius: 3px;
    }
    .mb-list::-webkit-scrollbar-thumb:hover {
        background: rgba(255, 255, 255, 0.3);
    }

    .mb-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        text-decoration: none;
        transition: background 0.2s;
        cursor: pointer;
    }

    .mb-item:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }

    /* Avatar */
    .mb-avatar-wrapper {
        position: relative;
        flex-shrink: 0;
        width: 48px;
        height: 48px;
        overflow: hidden;
        border-radius: 50%;
    }
    .mb-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        object-fit: cover;
        background-color: #333;
        display: block;
    }

    .mb-content {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .mb-row-top {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
    }

    .mb-name {
        font-size: 15px;
        font-weight: 600;
        color: var(--color-text-invert);
    }

    .mb-time {
        font-size: 11px;
        color: var(--color-bg-soft);
    }

    .mb-text {
        font-size: 13px;
        color: var(--color-bg-soft);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mb-item.unread .mb-text {
        color: var(--color-primary-light);
        font-weight: 600;
    }
    .mb-item.unread .mb-name {
        color: white;
    }
    /*Chấm tím */
    .mb-item.unread .mb-unread-dot {
        width: 10px;
        height: 10px;
        background-color: var(--color-purple-button);
        border-radius: 50%;
        flex-shrink: 0;
        margin-left: 8px;
        box-shadow: 0 0 5px var(--color-purple-button);
    }
</style>

<div class="message-dropdown">
    <button class="header-message" id="message-button" aria-label="Messages">
        <ion-icon name="chatbubble-outline"></ion-icon>
        {unreadCount > 0 && <span class="message-badge">{unreadCount}</span>}
    </button>

    <div class="message-box" id="message-dropdown-menu">
        <div class="mb-header">
            <div class="mb-title">
                {t('box-message.message')}
                {unreadCount > 0 ? `(${unreadCount})` : ''}
            </div>
            <a class="mb-view-all" href={l('/messages')}>
                {t('messages.viewAll')}
            </a>
        </div>

        <div class="mb-list">
            {
                conversations.length > 0 ? (
                    conversations.map((conversation) => (
                        <a
                            class:list={[
                                'mb-item',
                                { unread: conversation.unread > 0 },
                            ]}
                            href={l(
                                `/messages/${conversation.partner.username}`
                            )}
                        >
                            <div class="mb-avatar-wrapper">
                                <img
                                    src={
                                        conversation.partner.avatar_url ||
                                        '/assets/images/avatar-default-icon.png'
                                    }
                                    alt={conversation.partner.username}
                                    class="mb-avatar"
                                />
                            </div>
                            <div class="mb-content">
                                <div class="mb-row-top">
                                    <span class="mb-name">
                                        {conversation.partner.full_name ||
                                            conversation.partner.username}
                                    </span>
                                    <span class="mb-time">
                                        {formatTime(conversation.lastAt)}
                                    </span>
                                </div>
                                <div class="mb-row-bottom">
                                    <p class="mb-text">
                                        {conversation.lastMessage}
                                    </p>
                                    {conversation.unread > 0 && (
                                        <span class="mb-unread-dot" />
                                    )}
                                </div>
                            </div>
                        </a>
                    ))
                ) : (
                    <p class="mb-empty">{t('messages.empty')}</p>
                )
            }
        </div>
    </div>
</div>

<script>
    (function () {
        const button = document.getElementById('message-button');
        const menu = document.getElementById('message-dropdown-menu');
        if (!button || !menu || button.dataset.ready === 'true') return;
        button.dataset.ready = 'true';

        button.addEventListener('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            menu.classList.toggle('active');
            // Đóng dropdown thông báo nếu đang mở
            document
                .getElementById('notification-dropdown-menu')
                ?.classList.remove('active');
        });

        document.addEventListener('click', function (e) {
            const target = e.target;
            if (!(target instanceof Node)) return;
            if (!button.contains(target) && !menu.contains(target)) {
                menu.classList.remove('active');
            }
        });
    })();
</script>
