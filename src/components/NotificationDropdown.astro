---
import NotificationDialog from '@/components/NotificationDialog.astro';
import { getNotificationTranslations, getTranslation } from '@/i18n';
import '@/assets/css/notification-dropdown.css';

interface Props {
    userId: string;
    lang: 'vi' | 'en';
    l: (path: string) => string;
}

const { userId, lang, l } = Astro.props;
const translations = getNotificationTranslations(lang);
const t = (key: string) => getTranslation(lang, key);
---

<div
    class="notification-dropdown"
    data-lang={lang}
    data-translations={JSON.stringify(translations)}
>
    <button
        class="header-notification"
        id="notification-button"
        aria-label="Notifications"
    >
        <ion-icon name="notifications-outline"></ion-icon>
        <span class="notification-badge" style="display: none;">0</span>
    </button>

    <!-- Notification Dropdown Menu -->
    <div class="notification-dropdown__menu" id="notification-dropdown-menu">
        <div class="notification-header">
            <h3 class="notification-title">{t('header.notifications')}</h3>
            <button
                type="button"
                class="notification-mark-all"
                id="notification-mark-all"
                style="display: none;"
            >
                {t('flows.markAllRead')}
            </button>
            <span class="notification-unread-count" style="display: none;">
                0 {t('header.unread')}
            </span>
        </div>
        <div class="notification-list" id="notification-list">
            <div class="notification-loading">
                <p>{t('header.loadingNotifications')}</p>
            </div>
        </div>
    </div>
</div>

<!-- Notification Dialog -->
<NotificationDialog
    id="notification-dialog"
    titleId="notification-dialog-title"
    messageId="notification-dialog-message"
    timeId="notification-dialog-time"
    typeId="notification-dialog-type"
    closeButtonId="notification-dialog-close"
    showMeta={true}
    translations={JSON.stringify(translations)}
    currentLang={lang}
/>

<script src="@/assets/script/notification-dropdown.js"></script>
