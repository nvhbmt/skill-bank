---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import Header from '@/components/Header.astro';
import '@/assets/css/my-project.css';
import { useTranslate } from '@/i18n';

const session = Astro.locals.session;
const { lang, t, l } = useTranslate(Astro);

// Redirect if not logged in
if (!session?.user) {
    return Astro.redirect(l(`/sign-in`));
}
---

<DefaultLayout>
    <div class="wrapper">
        <Header />

        <main>
            <div class="my-projects-container">
                <!-- Header -->
                <div class="page-header">
                    <h1 class="page-title">{t('my-project.title')}</h1>
                    <p class="page-subtitle">{t('my-project.description')}</p>
                </div>

                <!-- Tabs Navigation -->
                <div class="tabs-container">
                    <button class="tab-btn active" data-tab="pending"
                        >{t('my-project.choDuyet')}</button
                    >
                    <button class="tab-btn" data-tab="approved"
                        >{t('my-project.daDuyet')}</button
                    >
                    <button class="tab-btn" data-tab="joined"
                        >{t('my-project.thamGia')}</button
                    >
                    <button class="tab-btn" data-tab="completed"
                        >{t('my-project.hoanThanh')}</button
                    >
                    <button class="tab-btn" data-tab="rejected"
                        >{t('flows.rejectedTab')}</button
                    >
                </div>

                <!-- CONTENT TAB 1: DỰ ÁN CHỜ DUYỆT -->
                <div id="pending" class="projects-grid tab-content">
                    <div id="pending-loading" class="projects-loading">
                        {
                            Array(3)
                                .fill(0)
                                .map(() => (
                                    <div class="project-skeleton">
                                        <div class="skeleton-header" />
                                        <div class="skeleton-status" />
                                    </div>
                                ))
                        }
                    </div>
                </div>

                <!-- CONTENT TAB 2: DỰ ÁN ĐÃ DUYỆT -->
                <div
                    id="approved"
                    class="projects-grid tab-content"
                    style="display: none;"
                >
                    <div id="approved-loading" class="projects-loading">
                        {
                            Array(3)
                                .fill(0)
                                .map(() => (
                                    <div class="project-skeleton">
                                        <div class="skeleton-header" />
                                        <div class="skeleton-status" />
                                    </div>
                                ))
                        }
                    </div>
                </div>

                <!-- CONTENT TAB 3: DỰ ÁN ĐÃ THAM GIA -->
                <div
                    id="joined"
                    class="projects-grid tab-content"
                    style="display: none;"
                >
                    <div id="joined-loading" class="projects-loading">
                        {
                            Array(3)
                                .fill(0)
                                .map(() => (
                                    <div class="project-skeleton">
                                        <div class="skeleton-header" />
                                        <div class="skeleton-status" />
                                    </div>
                                ))
                        }
                    </div>
                </div>

                <!-- CONTENT TAB 4: DỰ ÁN HOÀN THÀNH -->
                <div
                    id="completed"
                    class="projects-grid tab-content"
                    style="display: none;"
                >
                    <div id="completed-loading" class="projects-loading">
                        {
                            Array(3)
                                .fill(0)
                                .map(() => (
                                    <div class="project-skeleton">
                                        <div class="skeleton-header" />
                                        <div class="skeleton-status" />
                                    </div>
                                ))
                        }
                    </div>
                </div>

                <!-- CONTENT TAB 5: DỰ ÁN BỊ TỪ CHỐI -->
                <div
                    id="rejected"
                    class="projects-grid tab-content"
                    style="display: none;"
                >
                    <div id="rejected-loading" class="projects-loading">
                        {
                            Array(3)
                                .fill(0)
                                .map(() => (
                                    <div class="project-skeleton">
                                        <div class="skeleton-header" />
                                        <div class="skeleton-status" />
                                    </div>
                                ))
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script src="@/assets/script/my-project.js"></script>
</DefaultLayout>
