---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/assets/css/dashboard.css';
import { useTranslate } from '@/i18n';

const { t, l } = useTranslate(Astro);
const session = Astro.locals.session;

if (!session?.user) {
    return Astro.redirect(l('/sign-in'));
}

const user = session.user;
const userName = user?.user_metadata?.full_name || 'User';
---

<DefaultLayout>
    <div class="wrapper">
        <div class="grid-overlay"></div>
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>

        <Header />

        <main>
            <div class="dashboard-container">
                <!-- 1. HEADER -->
                <div class="dashboard-header">
                    <div class="welcome-text">
                        <h1>
                            {t('dashboard.welcome')}
                            <span>{userName}</span>! <span class="wave-hand"
                                >👋</span
                            >
                        </h1>
                        <p>{t('dashboard.subtitle')}</p>
                    </div>
                    <div class="date-badge">
                        {
                            new Date().toLocaleDateString('vi-VN', {
                                weekday: 'long',
                                day: 'numeric',
                                month: 'long',
                            })
                        }
                    </div>
                </div>

                <!-- 2. STATS -->
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon-box">
                            <i class="fa-solid fa-star"></i>
                        </div>
                        <div class="stat-info">
                            <h3 class="stat-value" id="stat-reputation">–</h3>
                            <p class="stat-label">
                                {t('dashboard.statReputation')}
                            </p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon-box">
                            <i class="fa-solid fa-thumbs-up"></i>
                        </div>
                        <div class="stat-info">
                            <h3 class="stat-value" id="stat-likes">–</h3>
                            <p class="stat-label">{t('dashboard.statLikes')}</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon-box">
                            <i class="fa-regular fa-eye"></i>
                        </div>
                        <div class="stat-info">
                            <h3 class="stat-value" id="stat-views">–</h3>
                            <p class="stat-label">{t('dashboard.statViews')}</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon-box">
                            <i class="fa-regular fa-envelope"></i>
                        </div>
                        <div class="stat-info">
                            <h3 class="stat-value" id="stat-invites">–</h3>
                            <p class="stat-label">
                                {t('dashboard.statInvites')}
                            </p>
                        </div>
                    </div>
                </div>

                <!-- 3. MAIN CONTENT -->
                <div class="dashboard-content">
                    <!-- LEFT COLUMN -->
                    <div class="main-column">
                        <!-- Recommended Projects-->
                        <div class="section-header">
                            <h2 class="section-title">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                                {t('dashboard.recommended')}
                            </h2>
                            <a href={l('/explore')} class="view-all-link"
                                >{t('dashboard.viewAll')} &rarr;</a
                            >
                        </div>

                        <div
                            class="projects-list-horizontal"
                            id="recommended-projects"
                        >
                            <div class="projects-loading">
                                {
                                    Array(3)
                                        .fill(0)
                                        .map(() => (
                                            <div class="project-card-horizontal skeleton">
                                                <div class="skeleton-image" />
                                                <div class="skeleton-content">
                                                    <div class="skeleton-tags" />
                                                    <div class="skeleton-title" />
                                                    <div class="skeleton-text" />
                                                </div>
                                            </div>
                                        ))
                                }
                            </div>
                        </div>

                        <!-- THÊM ĐƯỜNG KẺ NGANG NGĂN CÁCH -->
                        <div class="section-divider-horizontal"></div>

                        <!-- Trending Skills -->
                        <div class="section-header trending-section">
                            <h2 class="section-title">
                                <i class="fa-solid fa-arrow-trend-up"></i>
                                {t('dashboard.trendingSkills')}
                            </h2>
                        </div>
                        <div class="trending-grid" id="trending-skills">
                            <div class="skills-loading">
                                {
                                    Array(5)
                                        .fill(0)
                                        .map(() => (
                                            <div class="trend-tag skeleton">
                                                <div class="skeleton-text" />
                                            </div>
                                        ))
                                }
                            </div>
                        </div>
                    </div>

                    <!-- RIGHT COLUMN -->
                    <aside class="dashboard-sidebar">
                        <!-- Profile Strength -->
                        <div class="widget-card profile-strength-box">
                            <h3
                                style="color:white; margin-bottom:1rem; font-size:1.4rem; font-weight:700; align-self: flex-start;"
                            >
                                {t('dashboard.profileStrength')}
                            </h3>
                            <div
                                class="circle-chart"
                                id="profile-strength-chart"
                            >
                                <div class="loading-spinner"></div>
                            </div>
                            <div class="strength-info" id="strength-info">
                                <p
                                    style="font-size: 0.9rem; color: #9ca3af; margin-bottom: 1rem;"
                                >
                                    Đang tải...
                                </p>
                            </div>
                        </div>

                        <!-- Recent Activity -->
                        <div class="widget-card">
                            <h3
                                style="color:white; margin-bottom:1.5rem; font-size:1.4rem; font-weight:700;"
                            >
                                {t('dashboard.recentActivity')}
                            </h3>
                            <div class="activity-list" id="activity-list">
                                <div class="activities-loading">
                                    {
                                        Array(3)
                                            .fill(0)
                                            .map(() => (
                                                <div class="activity-item skeleton">
                                                    <div class="skeleton-icon" />
                                                    <div class="skeleton-text" />
                                                </div>
                                            ))
                                    }
                                </div>
                            </div>
                        </div>
                    </aside>
                </div>
            </div>
        </main>
        <Footer />
    </div>
    <script src="@/assets/script/dashboard.js"></script>
</DefaultLayout>
