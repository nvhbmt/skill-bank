---
import AuthPageLayout from '@/layouts/AuthPageLayout.astro';
import SuccessDialog from '@/components/SuccessDialog.astro';
import '@/assets/css/set-new-password.css';
import { useTranslate } from '@/i18n';

const { lang, t, l } = useTranslate(Astro);
---

<AuthPageLayout
    pageClass="set-new-password-page auth-page"
    title={t('set-new-password.title')}
    backLink={l('/sign-in')}
    backLinkText={t('set-new-password.backToSignIn')}
>
    <form slot="form" action="#" method="post">
        <div class="password-wrapper">
            <input
                type="password"
                id="password"
                name="password"
                placeholder={t('set-new-password.password')}
            />
            <div class="toggle-password">
                <!-- Icon mắt mở (ban đầu ẩn) -->
                <svg
                    class="icon-eye"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    style="display: none;"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 10.224 7.69 6 12 6c4.31 0 8.577 4.224 9.964 5.683.12.18.12.459 0 .639C20.577 13.776 16.31 18 12 18c-4.31 0-8.577-4.224-9.964-5.683Z"
                    ></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                </svg>
                <!-- Icon mắt chéo (ban đầu hiện) -->
                <svg
                    class="icon-eye-slash"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    style="display: block;"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"
                    ></path>
                </svg>
            </div>
        </div>

        <div class="password-wrapper">
            <input
                type="password"
                id="confirm-password"
                name="confirm-password"
                placeholder={t('set-new-password.confirmPass')}
            />
            <div class="toggle-password">
                <!-- Icon mắt mở (ban đầu ẩn) -->
                <svg
                    class="icon-eye"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    style="display: none;"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 10.224 7.69 6 12 6c4.31 0 8.577 4.224 9.964 5.683.12.18.12.459 0 .639C20.577 13.776 16.31 18 12 18c-4.31 0-8.577-4.224-9.964-5.683Z"
                    ></path>
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"></path>
                </svg>
                <!-- Icon mắt chéo (ban đầu hiện) -->
                <svg
                    class="icon-eye-slash"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="1.5"
                    stroke="currentColor"
                    style="display: block;"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88"
                    ></path>
                </svg>
            </div>
        </div>

        <button type="submit" class="reset"
            >{t('set-new-password.setNewPass')}</button
        >
    </form>
</AuthPageLayout>

<script src="@/assets/script/set-new-password.js"></script>

<SuccessDialog
    id="success-dialog"
    icon="✓"
    title={t('set-new-password.successTitle') || 'Đặt mật khẩu thành công!'}
    message={t('set-new-password.successMessage') ||
        'Mật khẩu của bạn đã được cập nhật thành công. Bạn có thể đăng nhập với mật khẩu mới.'}
    buttonText={t('set-new-password.backToHome') || 'Trở về trang chủ'}
    onCloseFunction="closeSuccessDialog()"
/>
