---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import '@/assets/css/project-handover-manager.css';
import Header from '@/components/Header.astro';
import ToastDialog from '@/components/ToastDialog.astro';
import ConfirmDialog from '@/components/ConfirmDialog.astro';
import { useTranslate } from '@/i18n';
import { supabase } from '@/lib/supabase';
import {
    getProjectApplications,
    getProjectMembers,
    type ApplicationWithApplicant,
    type ProjectMember,
} from '@/services/project-handover';
import { getProjectContracts } from '@/services/contracts';
import type { Tables } from '@/types/database.types';

const session = Astro.locals.session;
const { lang, t, l } = useTranslate(Astro);
const projectId = (Astro.params as { projectId?: string }).projectId;

// Redirect if not logged in
if (!session?.user) {
    return Astro.redirect(l(`/sign-in`));
}

// Initialize data
let project: Pick<Tables<'projects'>, 'id' | 'title' | 'owner_id'> | null =
    null;
let isOwner = false;
let pendingApplications: ApplicationWithApplicant[] = [];
let approvedApplications: ApplicationWithApplicant[] = [];
let projectMembers: ProjectMember[] = [];
let contracts: Awaited<ReturnType<typeof getProjectContracts>> = [];

// Fetch project and check ownership
if (projectId) {
    try {
        const projectIdNum = parseInt(projectId);
        if (!isNaN(projectIdNum)) {
            const { data: projectData, error: projectError } = await supabase
                .from('projects')
                .select('id, title, owner_id')
                .eq('id', projectIdNum)
                .is('deleted_at', null)
                .single();

            if (!projectError && projectData) {
                project = projectData;
                isOwner = session.user.id === project.owner_id;

                // Only fetch data if user is owner
                if (isOwner) {
                    const applications =
                        await getProjectApplications(projectIdNum);
                    pendingApplications = applications.pending;
                    approvedApplications = applications.approved;

                    projectMembers = await getProjectMembers(projectIdNum);
                    contracts = await getProjectContracts(projectIdNum);
                }
            }
        }
    } catch (error) {
        console.error('Error loading project handover:', error);
    }
}

// Redirect if not owner
if (!isOwner || !project) {
    return Astro.redirect(l(`/project/${projectId || ''}`));
}

// Helper function to format date
function formatDate(dateString: string | null): string {
    if (!dateString) return '';
    try {
        const date = new Date(dateString);
        return date.toLocaleDateString('vi-VN', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
        });
    } catch {
        return dateString;
    }
}
---

<DefaultLayout>
    <Header />
    <!-- Main Project Handover Container -->
    <div class="project-handover-page">
        <div class="project-handover-container">
            <div class="profile-list">
                <a
                    href={l(`/project/${project.id}`)}
                    class="skillbank-dropdown"
                >
                    {project.title}
                    <img src="/assets/images/Vector.svg" alt="" />
                </a>

                <div class="profile-items">
                    {
                        projectMembers.length > 0 ? (
                            projectMembers.map((member) => (
                                <a
                                    href={l(`/profile/${member.username}`)}
                                    class="profile-item"
                                >
                                    <img
                                        src={
                                            member.avatar_url ||
                                            '/assets/images/avt-nhỏ.svg'
                                        }
                                        alt={member.username}
                                    />
                                    <div class="profile-info">
                                        <div class="user-name">
                                            {member.full_name ||
                                                member.username}
                                        </div>
                                        <div class="email">{member.email}</div>
                                    </div>
                                </a>
                            ))
                        ) : (
                            <div class="no-members">
                                {t('project-handover-manager.noMembers')}
                            </div>
                        )
                    }
                </div>
            </div>

            <div class="handover-content">
                <div class="requests-column">
                    <div class="section-title">
                        {t('project-handover-manager.section-title-1')}
                    </div>
                    <div class="request-list">
                        {
                            pendingApplications.length > 0 ? (
                                pendingApplications.map((application) => (
                                    <div class="request-item light">
                                        <img
                                            src={
                                                application.applicant
                                                    ?.avatar_url ||
                                                '/assets/images/avt-nhỏ.svg'
                                            }
                                            alt={
                                                application.applicant
                                                    ?.username || ''
                                            }
                                        />
                                        <div class="request-info">
                                            <div class="request-name">
                                                {application.applicant
                                                    ?.full_name ||
                                                    application.applicant
                                                        ?.username ||
                                                    'Unknown'}
                                            </div>
                                            <div class="request-date">
                                                {formatDate(
                                                    application.applied_at
                                                )}
                                            </div>
                                        </div>
                                        <div class="request-actions">
                                            <button
                                                class="action-btn-small approve-btn"
                                                onclick={`approveApplication(${application.id}, ${project.id})`}
                                                title={t(
                                                    'project-handover-manager.approve'
                                                )}
                                            >
                                                ✓
                                            </button>
                                            <button
                                                class="action-btn-small reject-btn"
                                                onclick={`rejectApplication(${application.id}, ${project.id})`}
                                                title={t(
                                                    'project-handover-manager.reject'
                                                )}
                                            >
                                                ✕
                                            </button>
                                        </div>
                                    </div>
                                ))
                            ) : (
                                <div class="no-requests">
                                    {t(
                                        'project-handover-manager.noPendingRequests'
                                    )}
                                </div>
                            )
                        }
                    </div>

                    <div class="section-title">
                        {t('project-handover-manager.section-title-2')}
                    </div>
                    <div class="request-list">
                        {
                            approvedApplications.length > 0 ? (
                                approvedApplications.map((application) => (
                                    <div class="request-item green">
                                        <img
                                            src={
                                                application.applicant
                                                    ?.avatar_url ||
                                                '/assets/images/avt-nhỏ.svg'
                                            }
                                            alt={
                                                application.applicant
                                                    ?.username || ''
                                            }
                                        />
                                        <div class="request-info">
                                            <div class="request-name">
                                                {application.applicant
                                                    ?.full_name ||
                                                    application.applicant
                                                        ?.username ||
                                                    'Unknown'}
                                            </div>
                                            <div class="request-date">
                                                {formatDate(
                                                    application.applied_at
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                ))
                            ) : (
                                <div class="no-requests">
                                    {t(
                                        'project-handover-manager.noApprovedRequests'
                                    )}
                                </div>
                            )
                        }
                    </div>
                </div>

                <div class="divider"></div>

                <div class="description-column">
                    <h4 class="section-title">
                        {t('project-handover-manager.section-title-3')}
                    </h4>

                    <div class="collab-inputs">
                        {
                            (() => {
                                // Combine all applications (pending + approved)
                                const allApplications = [
                                    ...pendingApplications,
                                    ...approvedApplications,
                                ];

                                return allApplications.length > 0 ? (
                                    allApplications.map((application) => (
                                        <div class="collab-input-item">
                                            <div class="collab-label">
                                                @
                                                {application.applicant
                                                    ?.username || 'Unknown'}
                                            </div>
                                            <div class="collab-content">
                                                {application.cover_letter ||
                                                    t(
                                                        'project-handover-manager.noCoverLetter'
                                                    )}
                                            </div>
                                        </div>
                                    ))
                                ) : (
                                    <div class="no-notes">
                                        {t(
                                            'project-handover-manager.noCoverLetters'
                                        )}
                                    </div>
                                );
                            })()
                        }
                    </div>
                </div>
            </div>
            <div class="contracts-section">
                <h4 class="section-title">{t('contracts.sectionTitle')}</h4>
                {
                    projectMembers.filter((m) => m.role !== 'owner').length >
                    0 ? (
                        <div class="contract-list">
                            {projectMembers
                                .filter((m) => m.role !== 'owner')
                                .map((member) => {
                                    const contract = contracts.find(
                                        (c) => c.member_id === member.user_id
                                    );
                                    return (
                                        <div
                                            class="contract-card"
                                            data-member-id={member.user_id}
                                        >
                                            <div class="contract-head">
                                                <img
                                                    src={
                                                        member.avatar_url ||
                                                        '/assets/images/avt-nhỏ.svg'
                                                    }
                                                    alt={member.username}
                                                />
                                                <span class="user-name">
                                                    {member.full_name ||
                                                        member.username}
                                                </span>
                                                <button
                                                    type="button"
                                                    class="btn-remove-member"
                                                    data-member-id={
                                                        member.user_id
                                                    }
                                                    title={t(
                                                        'flows.removeMember'
                                                    )}
                                                >
                                                    <i class="fa-solid fa-user-minus" />
                                                </button>
                                                {!contract && (
                                                    <span class="contract-none">
                                                        {t(
                                                            'contracts.noContract'
                                                        )}
                                                    </span>
                                                )}
                                            </div>

                                            <label class="contract-label">
                                                {t('contracts.terms')}
                                            </label>
                                            <textarea
                                                class="contract-terms"
                                                rows="2"
                                                placeholder={t(
                                                    'contracts.termsPlaceholder'
                                                )}
                                                set:text={contract?.terms ?? ''}
                                            />

                                            <div class="contract-dates">
                                                <label>
                                                    {t('contracts.startDate')}
                                                    <input
                                                        type="date"
                                                        class="contract-start"
                                                        value={
                                                            contract?.start_date ??
                                                            ''
                                                        }
                                                    />
                                                </label>
                                                <label>
                                                    {t('contracts.endDate')}
                                                    <input
                                                        type="date"
                                                        class="contract-end"
                                                        value={
                                                            contract?.end_date ??
                                                            ''
                                                        }
                                                    />
                                                </label>
                                            </div>

                                            {contract &&
                                                contract.deliveries.length >
                                                    0 && (
                                                    <div class="contract-deliveries">
                                                        <strong>
                                                            {t(
                                                                'contracts.deliveries'
                                                            )}
                                                            :
                                                        </strong>
                                                        <ul>
                                                            {contract.deliveries.map(
                                                                (delivery) => (
                                                                    <li>
                                                                        {
                                                                            delivery.delivery_date
                                                                        }
                                                                        {delivery.description
                                                                            ? ` — ${delivery.description}`
                                                                            : ''}
                                                                    </li>
                                                                )
                                                            )}
                                                        </ul>
                                                    </div>
                                                )}

                                            <button
                                                type="button"
                                                class="action-btn-small approve-btn btn-save-contract"
                                            >
                                                {t('contracts.save')}
                                            </button>
                                        </div>
                                    );
                                })}
                        </div>
                    ) : (
                        <div class="no-requests">
                            {t('contracts.noMembers')}
                        </div>
                    )
                }
            </div>

            <div class="handover-submissions">
                <h4 class="section-title">
                    {t('project-handover-manager.handoverSectionTitle')}
                </h4>
                {
                    (() => {
                        const submitted = projectMembers.filter(
                            (m) => m.handover_id
                        );
                        return submitted.length > 0 ? (
                            <div class="handover-list">
                                {submitted.map((member) => (
                                    <div
                                        class="handover-item"
                                        data-status={member.handover_status}
                                    >
                                        <div class="handover-item-head">
                                            <img
                                                src={
                                                    member.avatar_url ||
                                                    '/assets/images/avt-nhỏ.svg'
                                                }
                                                alt={member.username}
                                            />
                                            <div class="handover-item-who">
                                                <div class="user-name">
                                                    {member.full_name ||
                                                        member.username}
                                                </div>
                                                <div class="handover-date">
                                                    {t(
                                                        'project-handover-manager.handoverSubmittedAt'
                                                    )}
                                                    :{' '}
                                                    {formatDate(
                                                        member.handover_submitted_at ??
                                                            null
                                                    )}
                                                </div>
                                            </div>
                                            <span
                                                class={`handover-badge handover-badge-${member.handover_status}`}
                                            >
                                                {member.handover_status ===
                                                'approved'
                                                    ? t(
                                                          'project-handover-manager.handoverApproved'
                                                      )
                                                    : member.handover_status ===
                                                        'rejected'
                                                      ? t(
                                                            'project-handover-manager.handoverRejected'
                                                        )
                                                      : t(
                                                            'project-handover-manager.handoverPending'
                                                        )}
                                            </span>
                                        </div>
                                        <p class="handover-notes">
                                            {member.handover_note}
                                        </p>
                                        {member.handover_review_note && (
                                            <p class="handover-review-note">
                                                {t(
                                                    'project-handover-manager.handoverReviewNote'
                                                )}
                                                : {member.handover_review_note}
                                            </p>
                                        )}
                                        {member.handover_status ===
                                            'pending' && (
                                            <div class="handover-actions">
                                                <button
                                                    class="action-btn-small approve-btn btn-handover-review"
                                                    data-handover-id={
                                                        member.handover_id
                                                    }
                                                    data-action="approve"
                                                >
                                                    {t(
                                                        'project-handover-manager.handoverApprove'
                                                    )}
                                                </button>
                                                <button
                                                    class="action-btn-small reject-btn btn-handover-review"
                                                    data-handover-id={
                                                        member.handover_id
                                                    }
                                                    data-action="reject"
                                                >
                                                    {t(
                                                        'project-handover-manager.handoverReject'
                                                    )}
                                                </button>
                                            </div>
                                        )}
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <div class="no-requests">
                                {t('project-handover-manager.noHandovers')}
                            </div>
                        );
                    })()
                }
            </div>

            <div class="action-buttons">
                <a href={l(`/project/${project.id}`)} class="status-btn">
                    {t('project-handover-manager.status-btn')}
                </a>
                <a href={l(`/project/${project.id}`)} class="details-btn">
                    {t('project-handover-manager.details-btn')}
                </a>
            </div>

            <script
                define:vars={{
                    approveTitle:
                        t('project-handover-manager.approve') ||
                        'Duyệt ứng viên',
                    approveConfirm: 'Bạn có chắc chắn muốn duyệt ứng viên này?',
                    approveSuccessTitle: 'Thành công',
                    approveSuccess: 'Duyệt ứng viên thành công!',
                    approveErrorTitle: 'Lỗi',
                    approveError: 'Có lỗi xảy ra khi duyệt ứng viên',
                    rejectTitle:
                        t('project-handover-manager.reject') ||
                        'Từ chối ứng viên',
                    rejectConfirm:
                        'Bạn có chắc chắn muốn từ chối ứng viên này?',
                    rejectSuccessTitle: 'Thành công',
                    rejectSuccess: 'Từ chối ứng viên thành công!',
                    rejectErrorTitle: 'Lỗi',
                    rejectError: 'Có lỗi xảy ra khi từ chối ứng viên',
                    errorMessage: 'Có lỗi xảy ra',
                    handoverProjectId: project.id,
                    handoverApproveTitle: t(
                        'project-handover-manager.handoverApprove'
                    ),
                    handoverRejectTitle: t(
                        'project-handover-manager.handoverReject'
                    ),
                    handoverApproveConfirm: t(
                        'project-handover-manager.handoverApproveConfirm'
                    ),
                    handoverRejectConfirm: t(
                        'project-handover-manager.handoverRejectConfirm'
                    ),
                    removeConfirmTitle: t('flows.removeConfirmTitle'),
                    removeConfirmMessage: t('flows.removeConfirmMessage'),
                    contractMessages: JSON.stringify({
                        save: t('contracts.save'),
                        saving: t('contracts.saving'),
                    }),
                }}
            >
                // Approve application
                window.approveApplication = async function (
                    applicationId,
                    projectId
                ) {
                    // Use ConfirmDialog instead of confirm()
                    if (window.openApproveApplicationDialog) {
                        window.openApproveApplicationDialog(
                            approveTitle,
                            approveConfirm,
                            async () => {
                                try {
                                    const response = await fetch(
                                        `/api/projects/${projectId}/applications/${applicationId}/approve`,
                                        {
                                            method: 'PUT',
                                            headers: {
                                                'Content-Type':
                                                    'application/json',
                                            },
                                        }
                                    );

                                    const result = await response.json();
                                    if (result.success) {
                                        if (window.showToast) {
                                            window.showToast({
                                                type: 'success',
                                                title: approveSuccessTitle,
                                                message: approveSuccess,
                                                onClose: () => {
                                                    location.reload();
                                                },
                                            });
                                        } else {
                                            location.reload();
                                        }
                                    } else {
                                        if (window.showToast) {
                                            window.showToast({
                                                type: 'error',
                                                title: approveErrorTitle,
                                                message:
                                                    result.message ||
                                                    errorMessage,
                                            });
                                        }
                                    }
                                } catch (error) {
                                    console.error(error);
                                    if (window.showToast) {
                                        window.showToast({
                                            type: 'error',
                                            title: approveErrorTitle,
                                            message: approveError,
                                        });
                                    }
                                }
                            }
                        );
                    }
                };

                // Reject application
                window.rejectApplication = async function (
                    applicationId,
                    projectId
                ) {
                    // Use ConfirmDialog instead of confirm()
                    if (window.openRejectApplicationDialog) {
                        window.openRejectApplicationDialog(
                            rejectTitle,
                            rejectConfirm,
                            async () => {
                                try {
                                    const response = await fetch(
                                        `/api/projects/${projectId}/applications/${applicationId}/reject`,
                                        {
                                            method: 'PUT',
                                            headers: {
                                                'Content-Type':
                                                    'application/json',
                                            },
                                        }
                                    );

                                    const result = await response.json();
                                    if (result.success) {
                                        if (window.showToast) {
                                            window.showToast({
                                                type: 'success',
                                                title: rejectSuccessTitle,
                                                message: rejectSuccess,
                                                onClose: () => {
                                                    location.reload();
                                                },
                                            });
                                        } else {
                                            location.reload();
                                        }
                                    } else {
                                        if (window.showToast) {
                                            window.showToast({
                                                type: 'error',
                                                title: rejectErrorTitle,
                                                message:
                                                    result.message ||
                                                    errorMessage,
                                            });
                                        }
                                    }
                                } catch (error) {
                                    console.error(error);
                                    if (window.showToast) {
                                        window.showToast({
                                            type: 'error',
                                            title: rejectErrorTitle,
                                            message: rejectError,
                                        });
                                    }
                                }
                            }
                        );
                    }
                };

                // Chủ dự án gỡ thành viên khỏi dự án
                document
                    .querySelectorAll('.btn-remove-member')
                    .forEach((button) => {
                        button.addEventListener('click', function () {
                            const run = async () => {
                                button.disabled = true;
                                try {
                                    const response = await fetch(
                                        `/api/projects/${handoverProjectId}/members`,
                                        {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type':
                                                    'application/json',
                                            },
                                            body: JSON.stringify({
                                                member_id:
                                                    button.dataset.memberId,
                                            }),
                                        }
                                    );
                                    const result = await response.json();
                                    window.showToast?.({
                                        type: result.success
                                            ? 'success'
                                            : 'error',
                                        title: result.success
                                            ? approveSuccessTitle
                                            : approveErrorTitle,
                                        message: result.message,
                                        onClose: () => location.reload(),
                                    });
                                    if (!result.success)
                                        button.disabled = false;
                                } catch (error) {
                                    button.disabled = false;
                                    console.error(
                                        'Error removing member:',
                                        error
                                    );
                                }
                            };

                            if (window.openApproveApplicationDialog) {
                                window.openApproveApplicationDialog(
                                    removeConfirmTitle,
                                    removeConfirmMessage,
                                    run
                                );
                            } else {
                                run();
                            }
                        });
                    });

                // Lưu hợp đồng với từng thành viên
                const contractMsg = JSON.parse(contractMessages);
                document
                    .querySelectorAll('.btn-save-contract')
                    .forEach((button) => {
                        button.addEventListener('click', async function () {
                            const card = button.closest('.contract-card');
                            if (!card) return;

                            const terms =
                                card.querySelector('.contract-terms')?.value ??
                                '';
                            const startDate =
                                card.querySelector('.contract-start')?.value ??
                                '';
                            const endDate =
                                card.querySelector('.contract-end')?.value ??
                                '';

                            button.disabled = true;
                            button.textContent = contractMsg.saving;

                            try {
                                const response = await fetch(
                                    `/api/projects/${handoverProjectId}/contracts`,
                                    {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        },
                                        body: JSON.stringify({
                                            member_id: card.dataset.memberId,
                                            terms,
                                            start_date: startDate,
                                            end_date: endDate,
                                        }),
                                    }
                                );
                                const result = await response.json();

                                window.showToast?.({
                                    type: result.success ? 'success' : 'error',
                                    title: result.success
                                        ? approveSuccessTitle
                                        : approveErrorTitle,
                                    message: result.message,
                                });
                            } catch (error) {
                                console.error('Error saving contract:', error);
                                window.showToast?.({
                                    type: 'error',
                                    title: approveErrorTitle,
                                    message: errorMessage,
                                });
                            } finally {
                                button.disabled = false;
                                button.textContent = contractMsg.save;
                            }
                        });
                    });

                // Nghiệm thu / trả lại bàn giao của thành viên
                document
                    .querySelectorAll('.btn-handover-review')
                    .forEach((button) => {
                        button.addEventListener('click', function () {
                            const handoverId = Number(
                                button.dataset.handoverId
                            );
                            const action = button.dataset.action;
                            const isApprove = action === 'approve';

                            const run = async () => {
                                button.disabled = true;
                                try {
                                    const response = await fetch(
                                        `/api/projects/${handoverProjectId}/handover/review`,
                                        {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type':
                                                    'application/json',
                                            },
                                            body: JSON.stringify({
                                                handover_id: handoverId,
                                                action,
                                            }),
                                        }
                                    );
                                    const result = await response.json();

                                    if (result.success) {
                                        window.showToast?.({
                                            type: 'success',
                                            title: approveSuccessTitle,
                                            message: result.message,
                                            onClose: () => location.reload(),
                                        });
                                    } else {
                                        button.disabled = false;
                                        window.showToast?.({
                                            type: 'error',
                                            title: approveErrorTitle,
                                            message:
                                                result.message || errorMessage,
                                        });
                                    }
                                } catch (error) {
                                    button.disabled = false;
                                    console.error(
                                        'Error reviewing handover:',
                                        error
                                    );
                                    window.showToast?.({
                                        type: 'error',
                                        title: approveErrorTitle,
                                        message: errorMessage,
                                    });
                                }
                            };

                            if (window.openApproveApplicationDialog) {
                                window.openApproveApplicationDialog(
                                    isApprove
                                        ? handoverApproveTitle
                                        : handoverRejectTitle,
                                    isApprove
                                        ? handoverApproveConfirm
                                        : handoverRejectConfirm,
                                    run
                                );
                            } else {
                                run();
                            }
                        });
                    });
            </script>
        </div>
    </div>

    <ToastDialog />

    <ConfirmDialog
        id="approve-application-dialog"
        confirmText={t('project-handover-manager.approve') || 'Duyệt'}
        cancelText={t('candidate-manage.cancel') || 'Hủy'}
    />

    <ConfirmDialog
        id="reject-application-dialog"
        confirmText={t('project-handover-manager.reject') || 'Từ chối'}
        cancelText={t('candidate-manage.cancel') || 'Hủy'}
    />
</DefaultLayout>
