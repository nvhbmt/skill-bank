---
import { useTranslate } from '@/i18n';

// Bản mockup tĩnh cũ. Trang quản lý bàn giao thật là
// /project-handover-manager/[projectId].
const { l } = useTranslate(Astro);
const projectId = (Astro.params as { projectId?: string }).projectId;

return Astro.redirect(
    projectId ? l(`/project-handover-manager/${projectId}`) : l('/my-project'),
    302
);
---
