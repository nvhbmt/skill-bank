---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import Header from '@/components/Header.astro';
import ConfirmDialog from '@/components/ConfirmDialog.astro';
import ShareDialog from '@/components/ShareDialog.astro';
import ProjectSkillDetailDialog from '@/components/ProjectSkillDetailDialog.astro';
import ProjectHandoverDialog from '@/components/ProjectHandoverDialog.astro';
import ToastDialog from '@/components/ToastDialog.astro';
import '@/assets/css/project.css';
import { useTranslate } from '@/i18n';
import { getProjectDetailById } from '@/services/project-detail';
import { getHandoverForMember } from '@/services/project-handover';
import { getReviewTargets } from '@/services/reviews';

const session = Astro.locals.session;
const { lang, t, l } = useTranslate(Astro);
const projectId = (Astro.params as { projectId?: string }).projectId;

// Fetch project data
if (!projectId) {
    return Astro.redirect(l(`/explore`));
}

const projectIdNum = parseInt(projectId);
if (isNaN(projectIdNum)) {
    return Astro.redirect(l(`/explore`));
}

const projectData = await getProjectDetailById(projectIdNum, session?.user?.id);

if (!projectData || !projectData.project) {
    return Astro.redirect(l(`/explore`));
}

const {
    project,
    owner,
    projectSkills,
    members,
    milestones,
    isOwner,
    isMember,
} = projectData;

// Tiến độ tính theo số mốc đã hoàn thành
const doneMilestones = milestones.filter((m) => m.completed_at).length;
const milestoneProgress =
    milestones.length > 0
        ? Math.round((doneMilestones / milestones.length) * 100)
        : 0;

// Sau khi dự án kết thúc, thành viên đánh giá lẫn nhau
const isCompleted = project?.status === 'completed';
const reviewTargets =
    isCompleted && session?.user && isMember
        ? await getReviewTargets(projectIdNum, session.user.id)
        : [];

// Bản bàn giao thành viên đã gửi trước đó (nếu có) để điền sẵn vào dialog
const myHandover =
    session?.user && isMember && !isOwner
        ? await getHandoverForMember(projectIdNum, session.user.id)
        : null;

// Format date helper
function formatDate(dateString: string | null): string {
    if (!dateString) return '';
    try {
        const date = new Date(dateString);
        return date.toLocaleDateString('vi-VN', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
        });
    } catch {
        return dateString;
    }
}
---

<DefaultLayout>
    <div class="wrapper">
        <Header />

        <main>
            <div class="project-detail-container">
                <div class="project-detail-body">
                    <!-- CỘT TRÁI: THÔNG TIN CHÍNH -->
                    <div class="column-main">
                        <!-- Phần Header -->
                        <div class="project-top-section">
                            <div class="project-info">
                                <h1 class="project-title">
                                    {
                                        project?.title ||
                                            t(
                                                'project-detail-collab.projectTitle'
                                            )
                                    }
                                </h1>

                                <div class="project-meta-list">
                                    <div class="meta-row">
                                        <span class="meta-label">
                                            {
                                                t(
                                                    'project-detail-collab.ngayBatDau'
                                                )
                                            }
                                        </span>
                                        <span class="meta-value">
                                            {
                                                project?.start_date
                                                    ? formatDate(
                                                          project.start_date
                                                      )
                                                    : '-'
                                            }
                                        </span>
                                    </div>
                                    <div class="meta-row">
                                        <span class="meta-label">
                                            {
                                                t(
                                                    'project-detail-collab.phanLoai'
                                                )
                                            }
                                        </span>
                                        <span class="meta-value">
                                            {project?.project_type || '-'}
                                        </span>
                                    </div>
                                    <div class="meta-row">
                                        <span class="meta-label">
                                            {t('project-detail-collab.điaDiem')}
                                        </span>
                                        <span class="meta-value">
                                            {project?.location || '-'}
                                        </span>
                                    </div>
                                </div>

                                <!-- CẬP NHẬT: Người đăng Profile Card -->
                                {
                                    owner && (
                                        <a
                                            href={l(
                                                `/profile/${owner.username}`
                                            )}
                                            class="creator-profile-card"
                                        >
                                            <div class="creator-avatar-wrapper">
                                                <img
                                                    src={
                                                        owner.avatar_url ||
                                                        '/assets/images/avatar-default-icon.png'
                                                    }
                                                    alt={t(
                                                        'project-detail-collab.creator'
                                                    )}
                                                />
                                                <span class="creator-badge-icon">
                                                    <i class="fa-solid fa-crown" />
                                                </span>
                                            </div>
                                            <div class="creator-text-info">
                                                <span class="creator-name">
                                                    {owner.full_name ||
                                                        owner.username}
                                                </span>
                                                <span class="creator-username">
                                                    @{owner.username}
                                                </span>
                                            </div>
                                        </a>
                                    )
                                }

                                <!-- CẬP NHẬT: Nút bấm UX đẹp -->
                            </div>

                            <!-- Ảnh dự án -->
                            {
                                project?.cover_image_url && (
                                    <div class="project-image-wrapper">
                                        <img
                                            src={project.cover_image_url}
                                            alt={t(
                                                'project-detail-collab.projectCover'
                                            )}
                                            class="project-image"
                                        />
                                    </div>
                                )
                            }
                        </div>
                        <div class="action-buttons">
                            <!-- Nút "Quản lý ứng viên" - chỉ hiện cho owner -->
                            {
                                isOwner && (
                                    <a
                                        href={l(
                                            `/project/${project?.id}/candidate-manage`
                                        )}
                                        class="action-btn btn-candidate-manage"
                                    >
                                        <i class="fa-solid fa-users" />
                                        {t(
                                            'project-detail-creator.candidateManage'
                                        ) || 'Quản lý ứng viên'}
                                    </a>
                                )
                            }
                            <!-- Nút "Xem bàn giao" - chỉ hiện cho owner -->
                            {
                                isOwner && (
                                    <a
                                        class="action-btn"
                                        href={l(
                                            `/project-handover-manager/${project?.id}`
                                        )}
                                    >
                                        <i class="fa-solid fa-file-import" />
                                        {t('project-detail-creator.xemBanGiao')}
                                    </a>
                                )
                            }
                            <!-- Nút "Bàn giao" - chỉ hiện cho member (không phải owner) -->
                            {
                                isMember && !isOwner && (
                                    <button
                                        class="action-btn btn-submit-handover"
                                        data-handover-status={
                                            myHandover?.status ?? ''
                                        }
                                    >
                                        <i class="fa-solid fa-file-import" />
                                        {t('project-detail-collab.banGiao')}
                                    </button>
                                )
                            }
                            <!-- Nút "Share" - hiện cho tất cả -->
                            <button
                                class="action-btn btn-share-project"
                                id="share-project-btn"
                                data-project-id={project?.id}
                            >
                                <i class="fa-solid fa-share"></i>
                                {t('project-detail-collab.share')}
                            </button>
                            <!-- Nút "Kết thúc dự án" - chủ dự án, khi đã duyệt -->
                            {
                                isOwner && project?.status === 'approved' && (
                                    <button
                                        class="action-btn btn-complete-project"
                                        id="complete-project-btn"
                                    >
                                        <i class="fa-solid fa-flag-checkered" />
                                        {t(
                                            'project-detail-creator.completeProject'
                                        )}
                                    </button>
                                )
                            }
                            <!-- Nút "Chỉnh sửa" - chỉ hiện cho owner -->
                            {
                                isOwner && (
                                    <a
                                        class="action-btn"
                                        href={l(`/project/${project?.id}/edit`)}
                                    >
                                        <i class="fa-solid fa-pen" />
                                        {t('create-project.editTitle')}
                                    </a>
                                )
                            }
                            <!-- Nút "Xóa dự án" - chỉ hiện cho owner -->
                            {
                                isOwner && (
                                    <button
                                        class="action-btn btn-delete-project"
                                        id="delete-project-btn"
                                        data-project-id={project?.id}
                                        data-project-title={
                                            project?.title || ''
                                        }
                                    >
                                        <i class="fa-solid fa-x" />
                                        {t('project-detail-creator.xoaDuAn')}
                                    </button>
                                )
                            }
                        </div>
                        <!-- Phần Mô tả -->
                        {
                            project?.description && (
                                <div class="description-box">
                                    <div class="box-header">
                                        <i class="fa-solid fa-caret-down" />
                                        <h3>
                                            {t('project-detail-collab.moTa')}
                                        </h3>
                                    </div>
                                    <div class="box-content">
                                        <p>{project.description}</p>
                                    </div>
                                </div>
                            )
                        }

                        <!-- Phần Kỹ năng -->
                        {
                            projectSkills.length > 0 && (
                                <div class="skills-section">
                                    <h3>
                                        {t('project-detail-collab.danhMucKN')}
                                    </h3>
                                    <div class="skills-list">
                                        {projectSkills.map((skill, index) => (
                                            <div class="skill-item-view">
                                                <span class="skill-label">
                                                    {t(
                                                        'project-detail-collab.KN'
                                                    )}{' '}
                                                    {index + 1}
                                                </span>
                                                <div class="skill-content">
                                                    <div class="skill-tag">
                                                        {skill.name}
                                                        {skill.category
                                                            ? ` / ${skill.category}`
                                                            : ''}
                                                    </div>
                                                    {!isOwner && !isMember && (
                                                        <button
                                                            type="button"
                                                            class="btn-skill-detail"
                                                            title={t(
                                                                'project-detail-collab.viewDetails'
                                                            )}
                                                            data-skill-name={
                                                                skill.name
                                                            }
                                                            data-skill-description={
                                                                skill.description ||
                                                                ''
                                                            }
                                                            data-application-url={l(
                                                                `/submit-application/${project?.id}`
                                                            )}
                                                        >
                                                            <span>
                                                                {t(
                                                                    'project-detail-collab.ungTuyen'
                                                                )}
                                                            </span>
                                                        </button>
                                                    )}
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )
                        }
                    </div>

                    <!-- CỘT PHẢI: SIDEBAR -->
                    <div class="column-sidebar">
                        <!-- Hoạt động biểu (Timeline) -->
                        {
                            milestones.length > 0 && (
                                <div class="sidebar-section timeline-section">
                                    <h3>
                                        {t(
                                            'project-detail-collab.activityChart'
                                        )}
                                    </h3>
                                    <div class="timeline-progress">
                                        <div class="timeline-progress-bar">
                                            <span
                                                style={`width: ${milestoneProgress}%`}
                                            />
                                        </div>
                                        <span class="timeline-progress-text">
                                            {doneMilestones}/{milestones.length}{' '}
                                            · {milestoneProgress}%
                                        </span>
                                    </div>
                                    <div class="timeline-cards">
                                        {milestones.map((milestone) => (
                                            <div
                                                class="timeline-card"
                                                data-done={Boolean(
                                                    milestone.completed_at
                                                )}
                                            >
                                                {isOwner ? (
                                                    <button
                                                        type="button"
                                                        class="milestone-toggle"
                                                        data-milestone-id={
                                                            milestone.id
                                                        }
                                                        aria-pressed={Boolean(
                                                            milestone.completed_at
                                                        )}
                                                        title={t(
                                                            'project-detail-creator.toggleMilestone'
                                                        )}
                                                    >
                                                        <i
                                                            class={
                                                                milestone.completed_at
                                                                    ? 'fa-solid fa-circle-check'
                                                                    : 'fa-regular fa-circle'
                                                            }
                                                        />
                                                    </button>
                                                ) : (
                                                    <i
                                                        class={
                                                            milestone.completed_at
                                                                ? 'fa-solid fa-circle-check'
                                                                : 'fa-regular fa-circle'
                                                        }
                                                    />
                                                )}
                                                <span>
                                                    {milestone.title}
                                                    {milestone.description
                                                        ? `: ${milestone.description}`
                                                        : ''}
                                                </span>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )
                        }

                        <!-- Thành viên -->
                        {
                            members.length > 0 && (
                                <div class="sidebar-section members-section">
                                    <h3>
                                        {t('project-detail-collab.Members')}
                                    </h3>
                                    <div class="members-list">
                                        {members.map((member) => (
                                            <a
                                                href={l(
                                                    `/profile/${member.username}`
                                                )}
                                                class="member-card"
                                            >
                                                <img
                                                    src={
                                                        member.avatar_url ||
                                                        '/assets/images/defaul-project-background.jpg'
                                                    }
                                                    alt={t(
                                                        'project-detail-collab.avatar'
                                                    )}
                                                    class="member-avatar"
                                                />
                                                <div class="member-info">
                                                    <span class="name">
                                                        {member.full_name ||
                                                            member.username}
                                                    </span>
                                                    <span class="username">
                                                        @{member.username}
                                                    </span>
                                                </div>
                                            </a>
                                        ))}
                                    </div>
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Confirm Delete Dialog -->
    <ConfirmDialog
        id="delete-project-dialog"
        titleId="delete-project-dialog-title"
        messageId="delete-project-dialog-message"
        confirmButtonId="delete-project-dialog-confirm"
        cancelButtonId="delete-project-dialog-cancel"
        confirmText={t('project-detail-creator.confirmDeleteButton')}
        cancelText={t('project-detail-creator.cancelButton')}
    />

    <!-- Share Dialog -->
    <ShareDialog
        id="share-project-dialog"
        titleId="share-project-dialog-title"
        linkInputId="share-project-dialog-link-input"
        copyButtonId="share-project-dialog-copy-button"
        closeButtonId="share-project-dialog-close"
        title={t('project-detail-creator.shareTitle')}
        linkLabel={t('project-detail-creator.shareLinkLabel')}
        copyButtonText={t('project-detail-creator.copyButton')}
        copiedButtonText={t('project-detail-creator.copiedButton')}
        closeButtonText={t('project-detail-creator.closeButton')}
    />

    <!-- Project Skill Detail Dialog (will be populated dynamically) -->
    <ProjectSkillDetailDialog
        skillName=""
        skillDescription=""
        applicationUrl=""
    />

    <!-- Project Handover Dialog -->
    {
        isCompleted && isMember && (
            <section class="project-review-section container">
                <h3>{t('project-review.sectionTitle')}</h3>
                <p class="project-review-intro">{t('project-review.intro')}</p>

                {reviewTargets.length > 0 ? (
                    <div class="project-review-list">
                        {reviewTargets.map((target) => (
                            <div
                                class="project-review-card"
                                data-reviewee-id={target.user_id}
                            >
                                <div class="project-review-who">
                                    <img
                                        src={
                                            target.avatar_url ||
                                            '/assets/images/avatar-default-icon.png'
                                        }
                                        alt={target.username}
                                    />
                                    <div>
                                        <div class="project-review-name">
                                            {target.full_name ||
                                                target.username}
                                        </div>
                                        <div class="project-review-role">
                                            {target.role}
                                        </div>
                                    </div>
                                </div>

                                <div
                                    class="project-review-stars"
                                    data-rating={target.myReview?.rating ?? 0}
                                >
                                    {[1, 2, 3, 4, 5].map((star) => (
                                        <button
                                            type="button"
                                            class="star-btn"
                                            data-star={star}
                                            aria-label={`${star}/5`}
                                        >
                                            <i
                                                class={
                                                    (target.myReview?.rating ??
                                                        0) >= star
                                                        ? 'fa-solid fa-star'
                                                        : 'fa-regular fa-star'
                                                }
                                            />
                                        </button>
                                    ))}
                                </div>

                                <textarea
                                    class="project-review-comment"
                                    rows="2"
                                    placeholder={t(
                                        'project-review.commentPlaceholder'
                                    )}
                                    set:text={target.myReview?.comment ?? ''}
                                />

                                <button
                                    type="button"
                                    class="btn btn-primary btn-send-review"
                                >
                                    {target.myReview
                                        ? t('project-review.update')
                                        : t('project-review.submit')}
                                </button>
                            </div>
                        ))}
                    </div>
                ) : (
                    <p class="project-review-empty">
                        {t('project-review.noTargets')}
                    </p>
                )}
            </section>
        )
    }

    <ProjectHandoverDialog
        id="project-handover-dialog"
        titleId="project-handover-dialog-title"
        notesId="project-handover-dialog-notes"
        backButtonId="project-handover-dialog-back"
        sendButtonId="project-handover-dialog-send"
        closeButtonId="project-handover-dialog-close"
        title={t('projectHandover-collaborator.title')}
        notesLabel={t('projectHandover-collaborator.notes')}
        note1={t('projectHandover-collaborator.project1')}
        note2={t('projectHandover-collaborator.project2')}
        backText={t('projectHandover-collaborator.back')}
        sendText={t('projectHandover-collaborator.send')}
    />

    <ToastDialog />
</DefaultLayout>

<script
    define:vars={{
        projectId: project?.id || 0,
        projectTitle: project?.title || '',
        lang: lang,
        confirmDeleteTitle: t('project-detail-creator.confirmDeleteTitle'),
        confirmDeleteMessage: t('project-detail-creator.confirmDeleteMessage'),
        myHandoverNotes: myHandover?.notes || '',
        completeConfirmTitle: t('project-detail-creator.completeConfirmTitle'),
        completeConfirmMessage: t(
            'project-detail-creator.completeConfirmMessage'
        ),
        reviewMessages: JSON.stringify({
            needRating: t('project-review.needRating'),
            sending: t('project-review.sending'),
            sent: t('project-review.sent'),
            submit: t('project-review.submit'),
            update: t('project-review.update'),
        }),
    }}
>
    (function () {
        // Delete button handler
        const deleteBtn = document.getElementById('delete-project-btn');

        if (deleteBtn) {
            deleteBtn.addEventListener('click', function () {
                // Replace {{projectTitle}} in message
                const message = confirmDeleteMessage.replace(
                    '{{projectTitle}}',
                    projectTitle
                );

                // Open confirm dialog
                if (window.openDeleteProjectDialog) {
                    window.openDeleteProjectDialog(
                        confirmDeleteTitle,
                        message,
                        async function () {
                            // Handle delete
                            try {
                                const response = await fetch(
                                    `/api/projects/${projectId}/delete`,
                                    {
                                        method: 'DELETE',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        },
                                    }
                                );

                                const result = await response.json();
                                if (result.success) {
                                    // Redirect to my projects page
                                    window.location.href = `/${lang}/my-project`;
                                } else {
                                    if (window.showToast) {
                                        window.showToast({
                                            type: 'error',
                                            title: 'Lỗi',
                                            message:
                                                result.message ||
                                                'Có lỗi xảy ra khi xóa dự án',
                                        });
                                    }
                                }
                            } catch (error) {
                                console.error('Error deleting project:', error);
                                if (window.showToast) {
                                    window.showToast({
                                        type: 'error',
                                        title: 'Lỗi',
                                        message: 'Có lỗi xảy ra khi xóa dự án',
                                    });
                                }
                            }
                        }
                    );
                }
            });
        }

        // Share button handler
        const shareBtn = document.getElementById('share-project-btn');

        if (shareBtn) {
            shareBtn.addEventListener('click', function () {
                // Get current URL
                const currentUrl = window.location.href;

                // Open share dialog
                if (window.openShareProjectDialog) {
                    window.openShareProjectDialog(currentUrl);
                }
            });
        }

        // Project skill detail dialog handlers
        const skillDetailButtons = document.querySelectorAll(
            '.btn-skill-detail[data-skill-name]'
        );
        const dialog = document.getElementById('project-skill-detail-dialog');
        const dialogSelect = document.getElementById('project-skill-select');
        const dialogTextarea = document.getElementById(
            'project-skill-description'
        );
        const dialogApplyBtn = document.getElementById('apply-project-skill');
        const dialogCloseBtn = document.getElementById(
            'close-project-skill-dialog'
        );
        const dialogCancelBtn = document.getElementById(
            'cancel-project-skill-dialog'
        );

        function openSkillDetailDialog(
            skillName,
            skillDescription,
            applicationUrl
        ) {
            if (!dialog || !dialogSelect || !dialogTextarea || !dialogApplyBtn)
                return;

            // Update dialog content
            dialogSelect.innerHTML = `<option value="${skillName}" selected>${skillName}</option>`;
            dialogTextarea.value = skillDescription || '';
            dialogApplyBtn.href = applicationUrl;

            // Show dialog
            dialog.classList.add('active');
        }

        function closeSkillDetailDialog() {
            if (dialog) {
                dialog.classList.remove('active');
            }
        }

        // Add click handlers to skill detail buttons
        skillDetailButtons.forEach((button) => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const skillName = button.getAttribute('data-skill-name') || '';
                const skillDescription =
                    button.getAttribute('data-skill-description') || '';
                const applicationUrl =
                    button.getAttribute('data-application-url') || '';

                openSkillDetailDialog(
                    skillName,
                    skillDescription,
                    applicationUrl
                );
            });
        });

        // Close dialog handlers
        if (dialogCloseBtn) {
            dialogCloseBtn.addEventListener('click', closeSkillDetailDialog);
        }

        if (dialogCancelBtn) {
            dialogCancelBtn.addEventListener('click', closeSkillDetailDialog);
        }

        // Close on overlay click
        const overlay = dialog?.querySelector(
            '.project-skill-detail-dialog-overlay'
        );
        if (overlay) {
            overlay.addEventListener('click', closeSkillDetailDialog);
        }

        // Chủ dự án tick / bỏ tick mốc hoàn thành
        document.querySelectorAll('.milestone-toggle').forEach((button) => {
            button.addEventListener('click', async function () {
                button.disabled = true;
                try {
                    const response = await fetch(
                        `/api/projects/${projectId}/milestones/toggle`,
                        {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                milestone_id: Number(
                                    button.dataset.milestoneId
                                ),
                            }),
                        }
                    );
                    const result = await response.json();
                    if (result.success) {
                        location.reload();
                    } else {
                        button.disabled = false;
                        window.showToast?.({
                            type: 'error',
                            title: 'Lỗi',
                            message: result.message,
                        });
                    }
                } catch (error) {
                    button.disabled = false;
                    console.error('Error toggling milestone:', error);
                }
            });
        });

        // Chủ dự án kết thúc dự án -> mở phần đánh giá cho thành viên
        const completeBtn = document.getElementById('complete-project-btn');
        if (completeBtn) {
            completeBtn.addEventListener('click', function () {
                const run = async () => {
                    completeBtn.disabled = true;
                    try {
                        const response = await fetch(
                            `/api/projects/${projectId}/complete`,
                            { method: 'POST' }
                        );
                        const result = await response.json();
                        if (result.success) {
                            window.showToast?.({
                                type: 'success',
                                title: 'Thành công',
                                message: result.message,
                                onClose: () => location.reload(),
                            });
                        } else {
                            completeBtn.disabled = false;
                            window.showToast?.({
                                type: 'error',
                                title: 'Lỗi',
                                message: result.message,
                            });
                        }
                    } catch (error) {
                        completeBtn.disabled = false;
                        console.error('Error completing project:', error);
                    }
                };

                if (window.openDeleteProjectDialog) {
                    window.openDeleteProjectDialog(
                        completeConfirmTitle,
                        completeConfirmMessage,
                        run
                    );
                } else {
                    run();
                }
            });
        }

        // Đánh giá thành viên sau khi dự án kết thúc
        const reviewMsg = JSON.parse(reviewMessages);
        document.querySelectorAll('.project-review-card').forEach((card) => {
            const starsBox = card.querySelector('.project-review-stars');
            const sendBtn = card.querySelector('.btn-send-review');
            if (!starsBox || !sendBtn) return;

            const paint = (rating) => {
                starsBox.dataset.rating = String(rating);
                starsBox.querySelectorAll('.star-btn').forEach((starBtn) => {
                    const icon = starBtn.querySelector('i');
                    const value = Number(starBtn.dataset.star);
                    icon.className =
                        value <= rating
                            ? 'fa-solid fa-star'
                            : 'fa-regular fa-star';
                });
            };

            starsBox.querySelectorAll('.star-btn').forEach((starBtn) => {
                starBtn.addEventListener('click', () =>
                    paint(Number(starBtn.dataset.star))
                );
            });

            sendBtn.addEventListener('click', async function () {
                const rating = Number(starsBox.dataset.rating || 0);
                if (!rating) {
                    window.showToast?.({
                        type: 'warning',
                        title: 'Thiếu thông tin',
                        message: reviewMsg.needRating,
                    });
                    return;
                }

                const comment =
                    card.querySelector('.project-review-comment')?.value ?? '';
                const originalLabel = sendBtn.textContent;
                sendBtn.disabled = true;
                sendBtn.textContent = reviewMsg.sending;

                try {
                    const response = await fetch(
                        `/api/projects/${projectId}/reviews`,
                        {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({
                                reviewee_id: card.dataset.revieweeId,
                                rating,
                                comment,
                            }),
                        }
                    );
                    const result = await response.json();
                    if (result.success) {
                        sendBtn.textContent = reviewMsg.update;
                        window.showToast?.({
                            type: 'success',
                            title: 'Thành công',
                            message: reviewMsg.sent,
                        });
                    } else {
                        sendBtn.textContent = originalLabel;
                        window.showToast?.({
                            type: 'error',
                            title: 'Lỗi',
                            message: result.message,
                        });
                    }
                } catch (error) {
                    sendBtn.textContent = originalLabel;
                    console.error('Error sending review:', error);
                } finally {
                    sendBtn.disabled = false;
                }
            });
        });

        // Thành viên bấm "Bàn giao" -> mở dialog, điền sẵn ghi chú lần trước
        const handoverButton = document.querySelector('.btn-submit-handover');
        if (handoverButton) {
            handoverButton.addEventListener('click', function () {
                if (window.openProjectHandoverDialog) {
                    window.openProjectHandoverDialog({
                        notes: myHandoverNotes,
                    });
                }
            });
        }

        // Gửi bàn giao lên server
        const handoverDialog = document.getElementById(
            'project-handover-dialog'
        );
        if (handoverDialog) {
            handoverDialog.addEventListener(
                'handover-send',
                async function (e) {
                    const { notes, setBusy, close } = e.detail;

                    if (!notes) {
                        window.showToast?.({
                            type: 'warning',
                            title: 'Thiếu nội dung',
                            message: 'Vui lòng nhập ghi chú bàn giao.',
                        });
                        return;
                    }

                    setBusy(true);
                    try {
                        const response = await fetch(
                            `/api/projects/${projectId}/handover`,
                            {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({ notes }),
                            }
                        );
                        const result = await response.json();

                        if (result.success) {
                            close();
                            window.showToast?.({
                                type: 'success',
                                title: 'Đã gửi bàn giao',
                                message: result.message,
                                onClose: () => window.location.reload(),
                            });
                        } else {
                            window.showToast?.({
                                type: 'error',
                                title: 'Gửi bàn giao thất bại',
                                message: result.message || 'Vui lòng thử lại.',
                            });
                        }
                    } catch (error) {
                        console.error('Error submitting handover:', error);
                        window.showToast?.({
                            type: 'error',
                            title: 'Lỗi kết nối',
                            message:
                                'Không gửi được bàn giao. Vui lòng thử lại.',
                        });
                    } finally {
                        setBusy(false);
                    }
                }
            );
        }
    })();
</script>
