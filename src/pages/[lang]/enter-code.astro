---
import AuthPageLayout from '@/layouts/AuthPageLayout.astro';
import '@/assets/css/enter-code.css';
import { useTranslate } from '@/i18n';

const { lang, t, l } = useTranslate(Astro);
---

<AuthPageLayout
    pageClass="enter-code-page auth-page"
    title={t('enter-code.title')}
    backLink={l('/')}
    backLinkText={t('enter-code.backToSignIn')}
>
    <form slot="form" action="#" method="post">
        <div class="input">
            <input class="otp-input" type="text" maxlength="1" />
            <input class="otp-input" type="text" maxlength="1" />
            <input class="otp-input" type="text" maxlength="1" />
            <input class="otp-input" type="text" maxlength="1" />
            <input class="otp-input" type="text" maxlength="1" />
            <input class="otp-input" type="text" maxlength="1" />
        </div>

        <div class="no-mail">
            <span>{t('enter-code.noEmail')}</span>
            <button class="resent" type="button"
                >{t('enter-code.resent')}</button
            >
        </div>

        <button class="continue">{t('enter-code.continue')}</button>
    </form>
</AuthPageLayout>
<script src="@/assets/script/enter-code.js"></script>
