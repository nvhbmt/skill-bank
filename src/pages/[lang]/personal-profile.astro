---
import { useTranslate } from '@/i18n';
import { supabase } from '@/lib/supabase';

// Trang này từng hiển thị dữ liệu giả (hardcode). Hồ sơ thật được render ở
// /profile/[username], nên đưa người dùng về đúng hồ sơ của họ.
const { l } = useTranslate(Astro);
const session = Astro.locals.session;

if (!session?.user) {
    return Astro.redirect(l('/sign-in'), 302);
}

const { data: userInfo } = await supabase
    .from('user_info')
    .select('username')
    .eq('user_id', session.user.id)
    .is('deleted_at', null)
    .maybeSingle();

return Astro.redirect(
    userInfo?.username ? l(`/profile/${userInfo.username}`) : l('/dashboard'),
    302
);
---
