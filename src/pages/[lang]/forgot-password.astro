---
import AuthPageLayout from '@/layouts/AuthPageLayout.astro';
import SuccessDialog from '@/components/SuccessDialog.astro';
import '@/assets/css/forgot-password.css';
import { useTranslate } from '@/i18n';

const { lang, t, l } = useTranslate(Astro);
const isLoggedIn = Astro.locals.session?.user;
if (isLoggedIn) {
    return Astro.redirect(l('/'));
}
---

<AuthPageLayout
    pageClass="forgot-page auth-page"
    title={t('forgot-password.title')}
    showHead={true}
    headText={t('forgot-password.newbie')}
    headLink={l('/sign-up')}
    headLinkText={t('forgot-password.signUp')}
    backLink={l('/sign-in')}
    backLinkText={t('forgot-password.backToSignIn')}
>
    <form slot="form" id="forgot-password-form" action="#" method="post">
        <input
            type="email"
            id="email"
            name="email"
            placeholder={t('forgot-password.emailPlaceholder') ||
                'Enter your email'}
            autocomplete="email"
            required
        />
        <div
            id="email-error"
            style="color: red; font-size: 0.875rem; margin-top: 0.5rem; min-height: 1.25rem;"
        >
        </div>
        <div
            id="success-message"
            style="display: none; font-size: 0.875rem; margin-top: 0.5rem; min-height: 1.25rem;"
        >
        </div>
        <br />
        <button type="submit" class="reset"
            >{t('forgot-password.resetPass')}</button
        >
    </form>
</AuthPageLayout>

<script src="@/assets/script/forgot-password.js"></script>

<SuccessDialog
    id="otp-sent-dialog"
    icon="✉"
    title={t('forgot-password.dialogTitle') || 'Đã gửi mã OTP!'}
    message={t('forgot-password.dialogMessage') ||
        'Chúng tôi đã gửi mã OTP đến email của bạn. Vui lòng kiểm tra hộp thư.'}
    buttonText={t('forgot-password.dialogButton') || 'Tiếp tục'}
    onCloseFunction="closeOtpSentDialog()"
/>
