---
import DefaultLayout from '@/layouts/DefaultLayout.astro';
import Header from '@/components/Header.astro';
import ToastDialog from '@/components/ToastDialog.astro';
import ConfirmDialog from '@/components/ConfirmDialog.astro';
import '@/assets/css/admin.css';
import { useTranslate } from '@/i18n';
import {
    getAllUsers,
    getPendingProjects,
    type UserInfo,
    type ProjectInfo,
} from '@/services/admin';
import { supabase } from '@/lib/supabase';

const session = Astro.locals.session;
const { lang, t, l } = useTranslate(Astro);

// Redirect if not logged in
if (!session?.user) {
    return Astro.redirect(l(`/sign-in`));
}

// Check if user is admin
let isAdmin = false;
try {
    const { data: userInfo } = await supabase
        .from('user_info')
        .select('role')
        .eq('user_id', session.user.id)
        .single();

    isAdmin = userInfo?.role === 'admin';
} catch (error) {
    console.error('Error checking admin status:', error);
}

if (!isAdmin) {
    return Astro.redirect(l(`/`));
}

// Fetch data
let users: UserInfo[] = [];
let pendingProjects: ProjectInfo[] = [];

try {
    users = await getAllUsers();
    pendingProjects = await getPendingProjects();
} catch (error) {
    console.error('Error loading admin data:', error);
}

// Helper function to format date
function formatDate(dateString: string | null): string {
    if (!dateString) return '';
    try {
        const date = new Date(dateString);
        return date.toLocaleDateString('vi-VN', {
            day: '2-digit',
            month: '2-digit',
            year: 'numeric',
        });
    } catch {
        return dateString;
    }
}
---

<DefaultLayout>
    <Header />
    <div class="admin-wrapper">
        <div class="admin-container">
            <h1 class="admin-title">{t('admin.title')}</h1>

            <!-- Tabs Navigation -->
            <div class="admin-tabs">
                <button class="admin-tab-btn active" data-tab="users">
                    {t('admin.users')}
                </button>
                <button class="admin-tab-btn" data-tab="projects">
                    {t('admin.projects')}
                </button>
            </div>

            <!-- Users Tab -->
            <div id="users-tab" class="admin-tab-content">
                <div class="admin-section">
                    <h2 class="admin-section-title">
                        {t('admin.userManagement')}
                    </h2>
                    <div class="admin-table-container">
                        <table class="admin-table">
                            <thead>
                                <tr>
                                    <th>{t('admin.username')}</th>
                                    <th>{t('admin.email')}</th>
                                    <th>{t('admin.fullName')}</th>
                                    <th>{t('admin.role')}</th>
                                    <th>{t('admin.createdAt')}</th>
                                    <th>{t('admin.actions')}</th>
                                </tr>
                            </thead>
                            <tbody>
                                {
                                    users.length > 0 ? (
                                        users.map((user) => (
                                            <tr>
                                                <td>
                                                    <div class="user-cell">
                                                        {user.avatar_url && (
                                                            <img
                                                                src={
                                                                    user.avatar_url
                                                                }
                                                                alt={
                                                                    user.username
                                                                }
                                                                class="user-avatar"
                                                            />
                                                        )}
                                                        <span>
                                                            {user.username}
                                                        </span>
                                                    </div>
                                                </td>
                                                <td>{user.email}</td>
                                                <td>{user.full_name || '-'}</td>
                                                <td>
                                                    <span
                                                        class={`role-badge role-${user.role}`}
                                                    >
                                                        {user.role}
                                                    </span>
                                                </td>
                                                <td>
                                                    {formatDate(
                                                        user.created_at
                                                    )}
                                                </td>
                                                <td>
                                                    <div class="action-buttons">
                                                        <a
                                                            href={l(
                                                                `/profile/${user.username}`
                                                            )}
                                                            class="action-btn view-btn"
                                                        >
                                                            {t('admin.view')}
                                                        </a>
                                                        <button
                                                            class="action-btn delete-btn"
                                                            data-user-id={
                                                                user.user_id
                                                            }
                                                            onclick={`deleteUser('${user.user_id}')`}
                                                        >
                                                            {t('admin.delete')}
                                                        </button>
                                                    </div>
                                                </td>
                                            </tr>
                                        ))
                                    ) : (
                                        <tr>
                                            <td colspan="6" class="no-data">
                                                {t('admin.noUsers')}
                                            </td>
                                        </tr>
                                    )
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Projects Tab -->
            <div
                id="projects-tab"
                class="admin-tab-content"
                style="display: none;"
            >
                <div class="admin-section">
                    <h2 class="admin-section-title">
                        {t('admin.projectApproval')}
                    </h2>
                    <div class="projects-list">
                        {
                            pendingProjects.length > 0 ? (
                                pendingProjects.map((project) => (
                                    <div class="project-card">
                                        <div class="project-header">
                                            <h3 class="project-title">
                                                {project.title}
                                            </h3>
                                            <span class="project-date">
                                                {formatDate(project.created_at)}
                                            </span>
                                        </div>
                                        <div class="project-info">
                                            <p class="project-description">
                                                {project.description ||
                                                    t('admin.noDescription')}
                                            </p>
                                            <div class="project-owner">
                                                <strong>
                                                    {t('admin.owner')}:
                                                </strong>{' '}
                                                {project.owner
                                                    ? `${project.owner.full_name || project.owner.username} (${project.owner.email})`
                                                    : '-'}
                                            </div>
                                        </div>
                                        <div class="project-actions">
                                            <a
                                                href={l(
                                                    `/project/${project.id}`
                                                )}
                                                class="action-btn view-btn"
                                                target="_blank"
                                            >
                                                {t('admin.viewDetails')}
                                            </a>
                                            <button
                                                class="action-btn approve-btn"
                                                data-project-id={project.id}
                                                onclick={`approveProject(${project.id})`}
                                            >
                                                {t('admin.approve')}
                                            </button>
                                            <button
                                                class="action-btn reject-btn"
                                                data-project-id={project.id}
                                                onclick={`rejectProject(${project.id})`}
                                            >
                                                {t('admin.reject')}
                                            </button>
                                        </div>
                                    </div>
                                ))
                            ) : (
                                <div class="no-data">
                                    {t('admin.noPendingProjects')}
                                </div>
                            )
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script
        define:vars={{
            approveTitle: t('admin.approve') || 'Duyệt dự án',
            approveConfirm: 'Bạn có chắc chắn muốn duyệt dự án này?',
            approveSuccessTitle: 'Thành công',
            approveSuccess: 'Duyệt dự án thành công!',
            approveErrorTitle: 'Lỗi',
            approveError: 'Có lỗi xảy ra khi duyệt dự án',
            rejectTitle: t('admin.reject') || 'Từ chối dự án',
            rejectConfirm: 'Bạn có chắc chắn muốn từ chối dự án này?',
            rejectSuccessTitle: 'Thành công',
            rejectSuccess: 'Từ chối dự án thành công!',
            rejectErrorTitle: 'Lỗi',
            rejectError: 'Có lỗi xảy ra khi từ chối dự án',
            deleteTitle: t('admin.delete') || 'Xóa người dùng',
            deleteConfirm: 'Bạn có chắc chắn muốn xóa người dùng này?',
            deleteSuccessTitle: 'Thành công',
            deleteSuccess: 'Xóa người dùng thành công!',
            deleteErrorTitle: 'Lỗi',
            deleteError: 'Có lỗi xảy ra khi xóa người dùng',
            errorMessage: 'Có lỗi xảy ra',
        }}
    >
        // Tab switching
        document.querySelectorAll('.admin-tab-btn').forEach((btn) => {
            btn.addEventListener('click', () => {
                const tabName = btn.getAttribute('data-tab');

                // Update buttons
                document.querySelectorAll('.admin-tab-btn').forEach((b) => {
                    b.classList.remove('active');
                });
                btn.classList.add('active');

                // Update content
                document
                    .querySelectorAll('.admin-tab-content')
                    .forEach((content) => {
                        content.style.display = 'none';
                    });
                const tabContent = document.getElementById(`${tabName}-tab`);
                if (tabContent) {
                    tabContent.style.display = 'block';
                }
            });
        });

        // Approve project
        window.approveProject = async function (projectId) {
            // Use ConfirmDialog instead of confirm()
            if (window.openApproveProjectDialog) {
                window.openApproveProjectDialog(
                    approveTitle,
                    approveConfirm,
                    async () => {
                        try {
                            const response = await fetch(
                                `/api/admin/projects/${projectId}/approve`,
                                {
                                    method: 'PUT',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    },
                                }
                            );

                            const result = await response.json();
                            if (result.success) {
                                if (window.showToast) {
                                    window.showToast({
                                        type: 'success',
                                        title: approveSuccessTitle,
                                        message: approveSuccess,
                                        onClose: () => {
                                            location.reload();
                                        },
                                    });
                                } else {
                                    location.reload();
                                }
                            } else {
                                if (window.showToast) {
                                    window.showToast({
                                        type: 'error',
                                        title: approveErrorTitle,
                                        message: result.message || errorMessage,
                                    });
                                }
                            }
                        } catch (error) {
                            console.error(error);
                            if (window.showToast) {
                                window.showToast({
                                    type: 'error',
                                    title: approveErrorTitle,
                                    message: approveError,
                                });
                            }
                        }
                    }
                );
            }
        };

        // Reject project
        window.rejectProject = async function (projectId) {
            // Use ConfirmDialog instead of confirm()
            if (window.openRejectProjectDialog) {
                window.openRejectProjectDialog(
                    rejectTitle,
                    rejectConfirm,
                    async () => {
                        try {
                            const response = await fetch(
                                `/api/admin/projects/${projectId}/reject`,
                                {
                                    method: 'PUT',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    },
                                }
                            );

                            const result = await response.json();
                            if (result.success) {
                                if (window.showToast) {
                                    window.showToast({
                                        type: 'success',
                                        title: rejectSuccessTitle,
                                        message: rejectSuccess,
                                        onClose: () => {
                                            location.reload();
                                        },
                                    });
                                } else {
                                    location.reload();
                                }
                            } else {
                                if (window.showToast) {
                                    window.showToast({
                                        type: 'error',
                                        title: rejectErrorTitle,
                                        message: result.message || errorMessage,
                                    });
                                }
                            }
                        } catch (error) {
                            console.error(error);
                            if (window.showToast) {
                                window.showToast({
                                    type: 'error',
                                    title: rejectErrorTitle,
                                    message: rejectError,
                                });
                            }
                        }
                    }
                );
            }
        };

        // Delete user
        window.deleteUser = async function (userId) {
            // Use ConfirmDialog instead of confirm()
            if (window.openDeleteUserDialog) {
                window.openDeleteUserDialog(
                    deleteTitle,
                    deleteConfirm,
                    async () => {
                        try {
                            const response = await fetch('/api/admin/users', {
                                method: 'PUT',
                                headers: {
                                    'Content-Type': 'application/json',
                                },
                                body: JSON.stringify({
                                    userId,
                                    updates: {
                                        deleted_at: new Date().toISOString(),
                                    },
                                }),
                            });

                            const result = await response.json();
                            if (result.success) {
                                if (window.showToast) {
                                    window.showToast({
                                        type: 'success',
                                        title: deleteSuccessTitle,
                                        message: deleteSuccess,
                                        onClose: () => {
                                            location.reload();
                                        },
                                    });
                                } else {
                                    location.reload();
                                }
                            } else {
                                if (window.showToast) {
                                    window.showToast({
                                        type: 'error',
                                        title: deleteErrorTitle,
                                        message: result.message || errorMessage,
                                    });
                                }
                            }
                        } catch (error) {
                            console.error(error);
                            if (window.showToast) {
                                window.showToast({
                                    type: 'error',
                                    title: deleteErrorTitle,
                                    message: deleteError,
                                });
                            }
                        }
                    }
                );
            }
        };
    </script>

    <ToastDialog />

    <ConfirmDialog
        id="approve-project-dialog"
        confirmText={t('admin.approve') || 'Duyệt'}
        cancelText={t('candidate-manage.cancel') || 'Hủy'}
    />

    <ConfirmDialog
        id="reject-project-dialog"
        confirmText={t('admin.reject') || 'Từ chối'}
        cancelText={t('candidate-manage.cancel') || 'Hủy'}
    />

    <ConfirmDialog
        id="delete-user-dialog"
        confirmText={t('admin.delete') || 'Xóa'}
        cancelText={t('candidate-manage.cancel') || 'Hủy'}
    />
</DefaultLayout>
